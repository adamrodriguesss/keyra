    {
      "name": "API keys",
      "item": [
        {
          "name": "Create key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/manager/products/{{productId}}/keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "manager",
                "products",
                "{{productId}}",
                "keys"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My key\",\n  \"scopes\": [],\n  \"expiresInDays\": 90,\n  \"rateLimitPerMinute\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{managerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Returns the full key once, in `key`. `neverExpires: true` (instead of `expiresInDays`) is admin-only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('apiKey', pm.response.json().key);",
                  "pm.collectionVariables.set('keyId', pm.response.json().apiKey.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/manager/products/{{productId}}/keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "manager",
                "products",
                "{{productId}}",
                "keys"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{managerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "`status` is `ACTIVE`, `REVOKED` or `EXPIRED`. `EXPIRED` is derived from `expiresAt`, not stored; the first request that sees a key expired records a one-time `EXPIRE` audit event."
          }
        },
        {
          "name": "Rotate key",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/manager/products/{{productId}}/keys/{{keyId}}/rotate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "manager",
                "products",
                "{{productId}}",
                "keys",
                "{{keyId}}",
                "rotate"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{managerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Issues a new secret under the same key id and prefix, returned once in `key`. The old secret keeps validating for `KEYRA_KEY_ROTATION_GRACE_HOURS` (default 24); only one old secret is kept, so rotating again ends the older one. 409 if the key is revoked or expired."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('previousApiKey', pm.collectionVariables.get('apiKey'));",
                  "pm.collectionVariables.set('apiKey', pm.response.json().key);"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke key",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/manager/products/{{productId}}/keys/{{keyId}}/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "manager",
                "products",
                "{{productId}}",
                "keys",
                "{{keyId}}",
                "revoke"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{managerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Immediate and irreversible: both the current and any old secret stop validating, and a second revoke or a rotate returns 409. Run the validate requests first if you want to see the grace period."
          }
        },
        {
          "name": "Validate key (public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/keys/validate",
              "host": [
                "{{baseUrl}}"
